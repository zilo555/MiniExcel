<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MiniExcelLibs</RootNamespace>
    <Title>MiniExcel.Rust</Title>
    <PackageId>MiniExcel.Rust</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Description>Experimental MiniExcel XLSX query API backed by Rust.</Description>
    <MiniExcelRustNativePath Condition="'$(MiniExcelRustNativePath)' == ''">$(MSBuildThisFileDirectory)..\..\..\MiniExcel-Rust\target\release\miniexcel_ffi.dll</MiniExcelRustNativePath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MiniExcelRustNativePath)')">
    <None Include="$(MiniExcelRustNativePath)" Pack="true" PackagePath="runtimes/win-x64/native/miniexcel_ffi.dll" />
  </ItemGroup>

  <Target Name="ValidateMiniExcelRustNativeAsset" BeforeTargets="Pack">
    <Error Condition="!Exists('$(MiniExcelRustNativePath)')" Text="Build miniexcel-ffi in Release mode before packing MiniExcel.Rust. Missing: $(MiniExcelRustNativePath)" />
  </Target>

</Project>